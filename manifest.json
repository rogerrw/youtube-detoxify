{
  "manifest_version": 3,
  "name": "YouTube Detoxify",
  "version": "1.0.0",
  "description": "A Chrome extension to help manage your YouTube usage",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://youtu.be/*",
    "https://www.youtube-nocookie.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["youtube-site/content.js"],
      "css": ["youtube-site/content.css"]
    },
    {
      "matches": ["<all_urls>"],
      "js": ["youtube-embeds/embed-detector.js"],
      "css": ["youtube-embeds/content.css"],
      "all_frames": false,
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["blocked.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
